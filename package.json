{
  "name": "clearframe",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node server.mjs",
    "check": "node --check server.mjs && node --check deployment.mjs && node --check dist/app.js && node --check scripts/build-pages.mjs",
    "test": ".venv/bin/python -m unittest discover -s tests -v",
    "start:background": "python3 scripts/local_service.py start",
    "stop:background": "python3 scripts/local_service.py stop",
    "build:pages": "node scripts/build-pages.mjs",
    "test:hosting": "node --test tests/hosting.test.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
